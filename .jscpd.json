{
  "threshold": 0,
  "exitCode": 1,
  "minTokens": 50,
  "reporters": ["console"],
  "gitignore": true,
  "ignore": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/*.log",
    "**/results/**",
    "data/**",
    "prompts/**",
    "reports/*.html",
    "docs/*.svg"
  ]
}
